# Copy this file to .env.local and fill in the values from your Supabase project.
# Dashboard > Project Settings > API Keys. Use the publishable key only.
# Never put the secret or service_role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Optional. Address of the ML API (see ml-api/README.md). Leave empty to hide ML estimates.
VITE_ML_API_URL=
