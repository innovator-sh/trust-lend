# Blockchain environment variables
# Copy this file to .env and fill in your values

# Hardhat reads these variable names (see hardhat.config.js).
# Use a dedicated test wallet. NEVER commit the real .env to git.
PRIVATE_KEY_DEPLOYER=your_deployer_private_key_here
PRIVATE_KEY_BORROWER=your_borrower_private_key_here
PRIVATE_KEY_LENDER=your_lender_private_key_here
PRIVATE_KEY_VOUCHER=your_voucher_private_key_here
LOCAL_RPC_URL=http://127.0.0.1:8545

# Polygon Amoy RPC (new testnet, more stable)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# PolygonScan API key for contract verification (optional)
# Get at: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_key_here
